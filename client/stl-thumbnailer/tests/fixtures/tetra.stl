solid tetra
  facet normal 0 0 -1
    outer loop
      vertex 0 0 0
      vertex 10 0 0
      vertex 5 10 0
    endloop
  endfacet
  facet normal 0 -1 1
    outer loop
      vertex 0 0 0
      vertex 5 10 0
      vertex 5 5 10
    endloop
  endfacet
  facet normal 1 0 1
    outer loop
      vertex 10 0 0
      vertex 5 5 10
      vertex 5 10 0
    endloop
  endfacet
  facet normal -1 0 1
    outer loop
      vertex 0 0 0
      vertex 5 5 10
      vertex 10 0 0
    endloop
  endfacet
endsolid tetra
